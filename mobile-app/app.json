{
  "expo": {
    "name": "Crisis Response",
    "slug": "crisis-response-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crisisresponse.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.crisisresponse.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Crisis Response to use your location for emergency services."
        }
      ],
      [
        "expo-notifications",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "89e69e47-762a-4508-a7b0-261f177d14ac"
      }
    }
  }
}
